{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d8\u05d9"
    },
    "last_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05e4\u05d7\u05d4"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "email": {
      "type": "string",
      "description": "\u05de\u05d9\u05d9\u05dc"
    },
    "preferred_branch_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e0\u05d9\u05e3 \u05de\u05d5\u05e2\u05d3\u05e3"
    },
    "preferred_branch_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05e0\u05d9\u05e3 \u05de\u05d5\u05e2\u05d3\u05e3 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "preferred_days": {
      "type": "string",
      "description": "\u05d9\u05de\u05d9\u05dd \u05de\u05d5\u05e2\u05d3\u05e4\u05d9\u05dd"
    },
    "preferred_hours": {
      "type": "string",
      "description": "\u05e9\u05e2\u05d5\u05ea \u05de\u05d5\u05e2\u05d3\u05e4\u05d5\u05ea"
    },
    "activity_area": {
      "type": "string",
      "enum": [
        "book_arrangement",
        "event_help",
        "reading_to_children",
        "technical_help",
        "other"
      ],
      "description": "\u05ea\u05d7\u05d5\u05dd \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea: \u05e1\u05d9\u05d3\u05d5\u05e8 \u05e1\u05e4\u05e8\u05d9\u05dd / \u05e2\u05d6\u05e8\u05d4 \u05d1\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd / \u05e7\u05e8\u05d9\u05d0\u05d4 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd / \u05e2\u05d6\u05e8\u05d4 \u05d8\u05db\u05e0\u05d9\u05ea / \u05d0\u05d7\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "waiting",
        "inactive"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1: \u05e4\u05e2\u05d9\u05dc\u05d4 / \u05d1\u05d4\u05de\u05ea\u05e0\u05d4 / \u05dc\u05d0 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}