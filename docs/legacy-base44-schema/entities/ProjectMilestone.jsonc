{
  "name": "ProjectMilestone",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "project_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d0\u05d1\u05df \u05d3\u05e8\u05da"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "related_domain": {
      "type": "string",
      "description": "\u05ea\u05d7\u05d5\u05dd \u05e7\u05e9\u05d5\u05e8"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "stuck"
      ],
      "default": "not_started",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1: \u05dc\u05d0 \u05d4\u05ea\u05d7\u05d9\u05dc / \u05d1\u05ea\u05d4\u05dc\u05d9\u05da / \u05d4\u05d5\u05e9\u05dc\u05dd / \u05ea\u05e7\u05d5\u05e2"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05ea\u05e7\u05d3\u05de\u05d5\u05ea"
    },
    "responsible": {
      "type": "string",
      "description": "\u05d0\u05d7\u05e8\u05d0\u05d9"
    },
    "related_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea - \u05de\u05d6\u05d4\u05d9\u05dd"
    },
    "is_completed": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d5\u05e9\u05dc\u05de\u05d4"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e9\u05dc\u05de\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "project_id",
    "name"
  ]
}