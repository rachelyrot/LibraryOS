{
  "name": "ProjectContact",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "project_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "task_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05d9\u05de\u05d4 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "contact_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8"
    },
    "contact_role": {
      "type": "string",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "contact_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "contact_email": {
      "type": "string",
      "description": "\u05de\u05d9\u05d9\u05dc"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "responsible",
        "partner",
        "executor",
        "other"
      ],
      "default": "other",
      "description": "\u05e1\u05d5\u05d2 \u05e7\u05e9\u05e8: \u05d0\u05d7\u05e8\u05d0\u05d9 / \u05e9\u05d5\u05ea\u05e3 / \u05d2\u05d5\u05e8\u05dd \u05de\u05d1\u05e6\u05e2 / \u05d0\u05d7\u05e8"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "project_id",
    "contact_name"
  ]
}