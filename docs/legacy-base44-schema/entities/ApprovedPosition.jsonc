{
  "name": "ApprovedPosition",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e0\u05d9\u05e3"
    },
    "branch_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05e0\u05d9\u05e3 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "position_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05ea\u05e7\u05df / \u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "scope_percentage": {
      "type": "number",
      "description": "\u05d4\u05d9\u05e7\u05e3 \u05ea\u05e7\u05df \u05d1\u05d0\u05d7\u05d5\u05d6\u05d9\u05dd"
    },
    "weekly_hours_approved": {
      "type": "number",
      "description": "\u05e9\u05e2\u05d5\u05ea \u05e9\u05d1\u05d5\u05e2\u05d9\u05d5\u05ea \u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea"
    },
    "approved_count": {
      "type": "number",
      "default": 1,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05ea\u05e7\u05e0\u05d9\u05dd \u05de\u05d0\u05d5\u05e9\u05e8\u05d9\u05dd"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "approval_source": {
      "type": "string",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d0\u05d9\u05e9\u05d5\u05e8 / \u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1: \u05e4\u05e2\u05d9\u05dc / \u05dc\u05d0 \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "branch_id",
    "position_name"
  ]
}