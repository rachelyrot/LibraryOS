{
  "name": "ProjectDocument",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "project_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd / \u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e1\u05de\u05da"
    },
    "file_url": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05e7\u05d5\u05d1\u05e5"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "approval",
        "quote",
        "plan",
        "contract",
        "image",
        "other"
      ],
      "default": "other",
      "description": "\u05e1\u05d5\u05d2 \u05de\u05e1\u05de\u05da: \u05d0\u05d9\u05e9\u05d5\u05e8 / \u05d4\u05e6\u05e2\u05ea \u05de\u05d7\u05d9\u05e8 / \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05e2\u05d1\u05d5\u05d3\u05d4 / \u05d7\u05d5\u05d6\u05d4 / \u05ea\u05de\u05d5\u05e0\u05d4 / \u05d0\u05d7\u05e8"
    },
    "uploaded_by": {
      "type": "string",
      "description": "\u05d4\u05d5\u05e2\u05dc\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "project_id",
    "name",
    "file_url"
  ]
}