{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "employee_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e2\u05d5\u05d1\u05d3\u05ea"
    },
    "employee_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e2\u05d5\u05d1\u05d3\u05ea (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "branch_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e0\u05d9\u05e3"
    },
    "branch_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05e0\u05d9\u05e3 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "planned_start": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05db\u05e0\u05d9\u05e1\u05d4 \u05de\u05ea\u05d5\u05db\u05e0\u05e0\u05ea"
    },
    "planned_end": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05d9\u05e6\u05d9\u05d0\u05d4 \u05de\u05ea\u05d5\u05db\u05e0\u05e0\u05ea"
    },
    "actual_start": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05db\u05e0\u05d9\u05e1\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "actual_end": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05d9\u05e6\u05d9\u05d0\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "status": {
      "type": "string",
      "enum": [
        "present",
        "late",
        "absent",
        "early_leave",
        "vacation"
      ],
      "default": "present",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1: \u05e0\u05db\u05d7\u05d4 / \u05d0\u05d9\u05d7\u05d5\u05e8 / \u05d7\u05d9\u05e1\u05d5\u05e8 / \u05d9\u05e6\u05d9\u05d0\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea / \u05d7\u05d5\u05e4\u05e9\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "date",
    "employee_id"
  ]
}