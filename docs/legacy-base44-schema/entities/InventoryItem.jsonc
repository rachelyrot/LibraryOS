{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d9\u05d8"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "subcategory": {
      "type": "string",
      "description": "\u05ea\u05ea-\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "current_quantity": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05e0\u05d5\u05db\u05d7\u05d9\u05ea"
    },
    "minimum_quantity": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd"
    },
    "unit": {
      "type": "string",
      "description": "\u05d9\u05d7\u05d9\u05d3\u05ea \u05de\u05d9\u05d3\u05d4"
    },
    "supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e4\u05e7"
    },
    "supplier_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05e4\u05e7"
    },
    "last_purchase_order_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d6\u05de\u05e0\u05ea \u05e8\u05db\u05e9 \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "last_received_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e7\u05d1\u05dc\u05d4 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "last_supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e4\u05e7 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "last_unit_price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d9\u05d7\u05d9\u05d3\u05d4 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "last_updated_by": {
      "type": "string",
      "description": "\u05e2\u05d3\u05db\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "isbn": {
      "type": "string",
      "description": "ISBN"
    },
    "author": {
      "type": "string",
      "description": "\u05de\u05d7\u05d1\u05e8"
    },
    "copies_in_agron": {
      "type": "number",
      "description": "\u05e2\u05d5\u05ea\u05e7\u05d9\u05dd \u05d1\u05d0\u05d2\u05e8\u05d5\u05df"
    },
    "movements": {
      "type": "array",
      "description": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05de\u05dc\u05d0\u05d9",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "purchase_order_id": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "quantity_added": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "category"
  ]
}