{
  "name": "ProjectGoal",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "project_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d9\u05e2\u05d3"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d9\u05e2\u05d3"
    },
    "success_metric": {
      "type": "string",
      "description": "\u05de\u05d3\u05d3 \u05d4\u05e6\u05dc\u05d7\u05d4"
    },
    "target_value": {
      "type": "number",
      "description": "\u05e2\u05e8\u05da \u05d9\u05e2\u05d3"
    },
    "current_value": {
      "type": "number",
      "default": 0,
      "description": "\u05e2\u05e8\u05da \u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "unit": {
      "type": "string",
      "description": "\u05d9\u05d7\u05d9\u05d3\u05ea \u05de\u05d3\u05d9\u05d3\u05d4"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05ea\u05e7\u05d3\u05de\u05d5\u05ea"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "achieved",
        "missed"
      ],
      "default": "not_started",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1: \u05dc\u05d0 \u05d4\u05ea\u05d7\u05d9\u05dc / \u05d1\u05ea\u05d4\u05dc\u05d9\u05da / \u05d4\u05d5\u05e9\u05d2 / \u05dc\u05d0 \u05d4\u05d5\u05e9\u05d2"
    }
  },
  "required": [
    "project_id",
    "name"
  ]
}