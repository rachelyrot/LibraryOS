{
  "name": "Employee",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d8\u05d9"
    },
    "last_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05e4\u05d7\u05d4"
    },
    "id_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d6\u05d4\u05d5\u05ea"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "email": {
      "type": "string",
      "description": "\u05de\u05d9\u05d9\u05dc"
    },
    "address": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05d7\u05d9\u05dc\u05ea \u05e2\u05d1\u05d5\u05d3\u05d4"
    },
    "position": {
      "type": "string",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "primary_branch_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e0\u05d9\u05e3 \u05e8\u05d0\u05e9\u05d9"
    },
    "primary_branch_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05e0\u05d9\u05e3 \u05e8\u05d0\u05e9\u05d9 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "additional_branch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e1\u05e0\u05d9\u05e4\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd - \u05de\u05d6\u05d4\u05d9\u05dd"
    },
    "additional_branch_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e1\u05e0\u05d9\u05e4\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "permanent",
        "temporary",
        "substitute",
        "volunteer",
        "student",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e2\u05e1\u05e7\u05d4: \u05e2\u05d5\u05d1\u05d3\u05ea \u05e7\u05d1\u05d5\u05e2\u05d4 / \u05d6\u05de\u05e0\u05d9\u05ea / \u05de\u05de\u05dc\u05d0\u05ea \u05de\u05e7\u05d5\u05dd / \u05de\u05ea\u05e0\u05d3\u05d1\u05ea / \u05e1\u05d8\u05d5\u05d3\u05e0\u05d8\u05d9\u05ea / \u05d0\u05d7\u05e8"
    },
    "scope_percentage": {
      "type": "number",
      "description": "\u05d4\u05d9\u05e7\u05e3 \u05de\u05e9\u05e8\u05d4 \u05d1\u05d0\u05d7\u05d5\u05d6\u05d9\u05dd"
    },
    "weekly_hours": {
      "type": "number",
      "description": "\u05e9\u05e2\u05d5\u05ea \u05e9\u05d1\u05d5\u05e2\u05d9\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "on_leave",
        "ended",
        "inactive"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1: \u05e4\u05e2\u05d9\u05dc\u05d4 / \u05d1\u05d7\u05d5\u05e4\u05e9\u05d4 / \u05e1\u05d9\u05d9\u05de\u05d4 \u05e2\u05d1\u05d5\u05d3\u05d4 / \u05dc\u05d0 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}