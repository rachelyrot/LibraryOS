{
  "name": "SupplierBookList",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e8\u05e9\u05d9\u05de\u05d4"
    },
    "supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e4\u05e7 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9 - \u05e8\u05e9\u05d9\u05de\u05d4 \u05e4\u05e0\u05d9\u05de\u05d9\u05ea \u05dc\u05dc\u05d0 \u05e1\u05e4\u05e7)"
    },
    "supplier_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05e4\u05e7 (\u05ea\u05e6\u05d5\u05d2\u05d4 - \u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "received_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e7\u05d1\u05dc\u05d4"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05e1\u05e4\u05e8\u05d9\u05dd \u2013 \u05de\u05d4\u05de\u05d0\u05d2\u05e8 \u05d4\u05de\u05e8\u05db\u05d6\u05d9"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "in_review",
        "books_selected",
        "transferred_to_quote",
        "closed"
      ],
      "default": "received",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d8\u05d9\u05e4\u05d5\u05dc"
    },
    "linked_order_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d6\u05de\u05e0\u05ea \u05d4\u05e8\u05db\u05e9 \u05e9\u05e0\u05d5\u05e6\u05e8\u05d4 \u05de\u05d4\u05e8\u05e9\u05d9\u05de\u05d4"
    },
    "linked_quote_request_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05e7\u05e9\u05ea \u05d4\u05e6\u05e2\u05ea \u05d4\u05de\u05d7\u05d9\u05e8 \u05dc\u05e1\u05e4\u05e8\u05d9\u05dd \u05e9\u05e0\u05d5\u05e6\u05e8\u05d4 \u05de\u05d4\u05e8\u05e9\u05d9\u05de\u05d4"
    },
    "file_url": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d1\u05e5 \u05de\u05e6\u05d5\u05e8\u05e3"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "books": {
      "type": "array",
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05e1\u05e4\u05e8\u05d9\u05dd",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "\u05e9\u05dd \u05e1\u05e4\u05e8"
          },
          "author": {
            "type": "string",
            "description": "\u05de\u05d7\u05d1\u05e8"
          },
          "publisher": {
            "type": "string",
            "description": "\u05d4\u05d5\u05e6\u05d0\u05d4"
          },
          "isbn": {
            "type": "string",
            "description": "ISBN"
          },
          "category": {
            "type": "string",
            "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
          },
          "nylon_required": {
            "type": "string",
            "enum": [
              "with_nylon",
              "without_nylon",
              "any"
            ],
            "default": "any",
            "description": "\u05e2\u05dd \u05e0\u05d9\u05d9\u05dc\u05d5\u05df / \u05d1\u05dc\u05d9 \u05e0\u05d9\u05d9\u05dc\u05d5\u05df / \u05dc\u05d0 \u05de\u05e9\u05e0\u05d4 (\u05dc\u05e4\u05d9 \u05d4\u05d6\u05d5\u05dc)"
          },
          "supplier_price": {
            "type": "number",
            "description": "\u05de\u05d7\u05d9\u05e8 \u05e1\u05e4\u05e7 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9 - \u05e0\u05e7\u05dc\u05d8 \u05de\u05d4\u05e6\u05e2\u05ea \u05de\u05d7\u05d9\u05e8)"
          },
          "discounted_price": {
            "type": "number",
            "description": "\u05de\u05d7\u05d9\u05e8 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e0\u05d7\u05d4 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
          },
          "recommended_quantity": {
            "type": "number",
            "description": "\u05db\u05de\u05d5\u05ea \u05de\u05d5\u05de\u05dc\u05e6\u05ea (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
          },
          "requested_quantity": {
            "type": "number",
            "description": "\u05db\u05de\u05d5\u05ea \u05de\u05d1\u05d5\u05e7\u05e9\u05ea (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
          },
          "existing_in_agron": {
            "type": "boolean",
            "default": false,
            "description": "\u05e7\u05d9\u05d9\u05dd \u05d1\u05d0\u05d2\u05e8\u05d5\u05df"
          },
          "existing_copies": {
            "type": "number",
            "default": 0,
            "description": "\u05de\u05e1\u05e4\u05e8 \u05e2\u05d5\u05ea\u05e7\u05d9\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd"
          },
          "system_recommendation": {
            "type": "string",
            "description": "\u05d4\u05de\u05dc\u05e6\u05ea \u05de\u05e2\u05e8\u05db\u05ea"
          },
          "recommendation_reason": {
            "type": "string",
            "description": "\u05e1\u05d9\u05d1\u05ea \u05d4\u05de\u05dc\u05e6\u05ea \u05de\u05e2\u05e8\u05db\u05ea"
          },
          "marked_for_order": {
            "type": "boolean",
            "default": false,
            "description": "\u05de\u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05d5\u05ea\u05d9 - \u05e1\u05e4\u05e8 \u05de\u05e1\u05d5\u05de\u05df \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4"
          },
          "selected_for_quote": {
            "type": "boolean",
            "default": false,
            "description": "\u05e0\u05d1\u05d7\u05e8 \u05dc\u05e9\u05dc\u05d9\u05d7\u05d4 \u05dc\u05e1\u05e4\u05e7\u05d9\u05dd \u05dc\u05e7\u05d1\u05dc\u05ea \u05d4\u05e6\u05e2\u05ea \u05de\u05d7\u05d9\u05e8"
          },
          "status": {
            "type": "string",
            "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e2\u05d1\u05e8\u05d4 \u05dc\u05d4\u05d6\u05de\u05e0\u05d4"
          },
          "notes": {
            "type": "string",
            "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}