{
  "name": "BudgetSource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e7\u05d5\u05e8 \u05d4\u05ea\u05e7\u05e6\u05d9\u05d1"
    },
    "funding_source_type": {
      "type": "string",
      "enum": [
        "municipal",
        "culture_ministry",
        "mifal_hapais",
        "kol_kore",
        "supplier_credit",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05de\u05e7\u05d5\u05e8 \u05de\u05d9\u05de\u05d5\u05df"
    },
    "color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9"
    },
    "total_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05db\u05d5\u05dc\u05dc \u20aa (\u05de\u05d7\u05d5\u05e9\u05d1 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05de\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea)"
    },
    "reserved_amount": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05db\u05d5\u05dd \u05de\u05e9\u05d5\u05e8\u05d9\u05d9\u05df (\u05de\u05d7\u05d5\u05e9\u05d1 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea)"
    },
    "spent_amount": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05db\u05d5\u05dd \u05e0\u05d5\u05e6\u05dc \u05d1\u05e4\u05d5\u05e2\u05dc (\u05de\u05d7\u05d5\u05e9\u05d1 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea)"
    },
    "available_amount": {
      "type": "number",
      "description": "\u05d9\u05ea\u05e8\u05d4 \u05d6\u05de\u05d9\u05e0\u05d4 (\u05de\u05d7\u05d5\u05e9\u05d1 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea)"
    },
    "year": {
      "type": "string",
      "description": "\u05e9\u05e0\u05ea \u05ea\u05e7\u05e6\u05d9\u05d1"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "frozen",
        "closed",
        "pending"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    }
  },
  "required": [
    "name"
  ]
}