{
  "name": "Schedule",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "day_of_week": {
      "type": "string",
      "description": "\u05d9\u05d5\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2"
    },
    "branch_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e0\u05d9\u05e3"
    },
    "branch_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05e0\u05d9\u05e3 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "person_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e2\u05d5\u05d1\u05d3\u05ea/\u05de\u05ea\u05e0\u05d3\u05d1\u05ea"
    },
    "person_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e2\u05d5\u05d1\u05d3\u05ea/\u05de\u05ea\u05e0\u05d3\u05d1\u05ea (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "person_type": {
      "type": "string",
      "enum": [
        "employee",
        "volunteer"
      ],
      "default": "employee",
      "description": "\u05e1\u05d5\u05d2 \u05d0\u05d3\u05dd: \u05e2\u05d5\u05d1\u05d3\u05ea / \u05de\u05ea\u05e0\u05d3\u05d1\u05ea"
    },
    "start_time": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_time": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd"
    },
    "role_in_shift": {
      "type": "string",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d1\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "morning",
        "afternoon",
        "evening",
        "full_day",
        "replacement",
        "reinforcement",
        "volunteer",
        "special_event"
      ],
      "default": "full_day",
      "description": "\u05e1\u05d5\u05d2 \u05de\u05e9\u05de\u05e8\u05ea: \u05d1\u05d5\u05e7\u05e8 / \u05d0\u05d7\u05e8 \u05e6\u05d4\u05e8\u05d9\u05d9\u05dd / \u05e2\u05e8\u05d1 / \u05d9\u05d5\u05dd \u05de\u05dc\u05d0 / \u05d4\u05d7\u05dc\u05e4\u05d4 / \u05ea\u05d2\u05d1\u05d5\u05e8 / \u05d4\u05ea\u05e0\u05d3\u05d1\u05d5\u05ea / \u05d0\u05d9\u05e8\u05d5\u05e2 \u05de\u05d9\u05d5\u05d7\u05d3"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "approved",
        "completed",
        "cancelled"
      ],
      "default": "planned",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1: \u05de\u05ea\u05d5\u05db\u05e0\u05df / \u05d0\u05d5\u05e9\u05e8 / \u05d1\u05d5\u05e6\u05e2 / \u05d1\u05d5\u05d8\u05dc"
    }
  },
  "required": [
    "date",
    "branch_id",
    "person_id"
  ]
}