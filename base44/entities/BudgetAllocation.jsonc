{
  "name": "BudgetAllocation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "budget_source_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e7\u05d5\u05e8 \u05d4\u05ea\u05e7\u05e6\u05d9\u05d1"
    },
    "color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05dc\u05d2\u05e8\u05e3"
    },
    "allocated_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05de\u05d5\u05e7\u05e6\u05d4 \u20aa"
    },
    "reserved_amount": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05db\u05d5\u05dd \u05de\u05e9\u05d5\u05e8\u05d9\u05d9\u05df (\u05d4\u05d6\u05de\u05e0\u05d5\u05ea \u05e9\u05d0\u05d5\u05e9\u05e8\u05d5)"
    },
    "spent_amount": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05db\u05d5\u05dd \u05e0\u05d5\u05e6\u05dc \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "remaining_amount": {
      "type": "number",
      "description": "\u05d9\u05ea\u05e8\u05d4 \u20aa = \u05de\u05d5\u05e7\u05e6\u05d4 - \u05de\u05e9\u05d5\u05e8\u05d9\u05d9\u05df - \u05e0\u05d5\u05e6\u05dc"
    },
    "notes": {
      "type": "string"
    },
    "transactions": {
      "type": "array",
      "description": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d5\u05e6\u05d0\u05d5\u05ea",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "supplier_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "is_manual": {
            "type": "boolean",
            "default": true,
            "description": "\u05d4\u05d0\u05dd \u05d4\u05d5\u05e6\u05d0\u05d4 \u05d9\u05d3\u05e0\u05d9\u05ea \u05d0\u05d5 \u05de\u05d4\u05d6\u05de\u05e0\u05ea \u05e8\u05db\u05e9"
          },
          "order_id": {
            "type": "string",
            "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d4\u05d6\u05de\u05e0\u05ea \u05e8\u05db\u05e9"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "allocated_amount"
  ]
}