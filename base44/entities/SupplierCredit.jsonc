{
  "name": "SupplierCredit",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e4\u05e7"
    },
    "supplier_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05e4\u05e7 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "credit_type": {
      "type": "string",
      "enum": [
        "supplier_credit",
        "refund",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d6\u05d9\u05db\u05d5\u05d9"
    },
    "total_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d6\u05d9\u05db\u05d5\u05d9 \u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "reserved_amount": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05db\u05d5\u05dd \u05de\u05e9\u05d5\u05e8\u05d9\u05d9\u05df"
    },
    "used_amount": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05db\u05d5\u05dd \u05e0\u05d5\u05e6\u05dc"
    },
    "remaining_amount": {
      "type": "number",
      "description": "\u05d9\u05ea\u05e8\u05d4 = total_amount - reserved_amount - used_amount"
    },
    "reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d4\u05d6\u05d9\u05db\u05d5\u05d9"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e6\u05d9\u05e8\u05d4"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d5\u05e7\u05e3"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "exhausted",
        "expired",
        "cancelled"
      ],
      "default": "active"
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "order_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "description": "reserved / used / released"
          }
        }
      }
    }
  },
  "required": [
    "supplier_id",
    "total_amount"
  ]
}