{
  "name": "ProjectTask",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "project_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "phase": {
      "type": "string",
      "description": "\u05e9\u05dc\u05d1"
    },
    "domain": {
      "type": "string",
      "description": "\u05ea\u05d7\u05d5\u05dd"
    },
    "sub_domain": {
      "type": "string",
      "description": "\u05ea\u05ea-\u05ea\u05d7\u05d5\u05dd"
    },
    "task_description": {
      "type": "string",
      "description": "\u05de\u05e9\u05d9\u05de\u05d4 \u05de\u05e4\u05d5\u05e8\u05d8\u05ea"
    },
    "assignee": {
      "type": "string",
      "description": "\u05d0\u05d7\u05e8\u05d0\u05d9 \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "partners": {
      "type": "string",
      "description": "\u05e9\u05d5\u05ea\u05e4\u05d9\u05dd \u05dc\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "executing_parties": {
      "type": "string",
      "description": "\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 - \u05e1\u05e4\u05e7\u05d9\u05dd / \u05d9\u05d5\u05e2\u05e6\u05d9\u05dd / \u05e2\u05d5\u05d1\u05d3\u05d9\u05dd / \u05d2\u05d5\u05e8\u05de\u05d9 \u05e2\u05d9\u05e8\u05d9\u05d9\u05d4"
    },
    "contact_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8"
    },
    "contact_role": {
      "type": "string",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8"
    },
    "contact_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8"
    },
    "contact_email": {
      "type": "string",
      "description": "\u05de\u05d9\u05d9\u05dc \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "estimated_duration": {
      "type": "string",
      "description": "\u05de\u05e9\u05da \u05de\u05e9\u05d5\u05e2\u05e8"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea: \u05d2\u05d1\u05d5\u05d4\u05d4 / \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea / \u05e0\u05de\u05d5\u05db\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "waiting_approval",
        "waiting_external",
        "completed",
        "cancelled",
        "stuck"
      ],
      "default": "not_started",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1: \u05dc\u05d0 \u05d4\u05ea\u05d7\u05d9\u05dc / \u05d1\u05ea\u05d4\u05dc\u05d9\u05da / \u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 / \u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d2\u05d5\u05e8\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 / \u05d4\u05d5\u05e9\u05dc\u05dd / \u05d1\u05d5\u05d8\u05dc / \u05ea\u05e7\u05d5\u05e2"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05ea\u05e7\u05d3\u05de\u05d5\u05ea"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e7\u05d1\u05e6\u05d9\u05dd \u05de\u05e6\u05d5\u05e8\u05e4\u05d9\u05dd"
    },
    "depends_on_task_id": {
      "type": "string",
      "description": "\u05ea\u05dc\u05d5\u05ea \u05d1\u05de\u05e9\u05d9\u05de\u05d4 \u05d0\u05d7\u05e8\u05ea - \u05de\u05d6\u05d4\u05d4"
    },
    "depends_on_task_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05d9\u05de\u05ea \u05ea\u05dc\u05d5\u05ea (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    }
  },
  "required": [
    "project_id",
    "task_description"
  ]
}