{
  "name": "ProjectDomain",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "project_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05ea\u05d7\u05d5\u05dd"
    },
    "parent_domain_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05ea\u05d7\u05d5\u05dd \u05d0\u05d1 (\u05dc\u05ea\u05ea\u05d9-\u05ea\u05d7\u05d5\u05de\u05d9\u05dd)"
    },
    "parent_domain_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05ea\u05d7\u05d5\u05dd \u05d0\u05d1 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1: \u05e4\u05e2\u05d9\u05dc / \u05dc\u05d0 \u05e4\u05e2\u05d9\u05dc"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05de\u05d9\u05d5\u05df"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "project_id",
    "name"
  ]
}