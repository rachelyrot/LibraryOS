{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "category_type": {
      "type": "string",
      "enum": [
        "main",
        "sub"
      ],
      "description": "\u05e8\u05d0\u05e9\u05d9\u05ea \u05d0\u05d5 \u05ea\u05ea-\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "parent_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d0\u05d1 (\u05dc\u05ea\u05ea-\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea)"
    },
    "parent_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d0\u05d1 (\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05de\u05d9\u05d5\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u2013 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05dc\u05d0 \u05e0\u05de\u05d7\u05e7\u05d5\u05ea, \u05e8\u05e7 \u05de\u05d5\u05e9\u05d1\u05ea\u05d5\u05ea"
    }
  },
  "required": [
    "name",
    "category_type"
  ]
}